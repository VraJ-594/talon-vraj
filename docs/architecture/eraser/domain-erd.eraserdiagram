entity-relationship-diagram
colorMode pastel
styleMode plain
typeface clean

workspace { id uuid pk; name varchar; default_timezone varchar }
app_user { id uuid pk; normalized_email varchar unique; password_hash varchar; status varchar }
workspace_membership { id uuid pk; workspace_id uuid fk; user_id uuid fk; role varchar }
refresh_session { id uuid pk; user_id uuid fk; workspace_id uuid fk; token_hash varchar unique; expires_at timestamptz }
job { id uuid pk; workspace_id uuid fk; title varchar; status varchar }
candidate { id uuid pk; workspace_id uuid fk; normalized_email varchar; first_name varchar; last_name varchar }
application { id uuid pk; workspace_id uuid fk; candidate_id uuid fk; job_id uuid fk; expected_ctc_minor bigint; resume_file_id uuid fk }
file_object { id uuid pk; workspace_id uuid fk; object_key varchar; scan_status varchar; storage_state varchar }
import_job { id uuid pk; workspace_id uuid fk; job_id uuid fk; status varchar; mapping jsonb }
import_row { id uuid pk; workspace_id uuid fk; import_job_id uuid fk; row_number integer; status varchar; application_id uuid fk }
export_job { id uuid pk; workspace_id uuid fk; criteria jsonb; file_id uuid fk; expires_at timestamptz }
resume_search_document { id uuid pk; workspace_id uuid fk; application_id uuid fk; file_id uuid fk; search_vector tsvector }

workspace_membership.workspace_id > workspace.id
workspace_membership.user_id > app_user.id
refresh_session.user_id > app_user.id
refresh_session.workspace_id > workspace.id
job.workspace_id > workspace.id
candidate.workspace_id > workspace.id
application.candidate_id > candidate.id
application.job_id > job.id
application.resume_file_id > file_object.id
file_object.workspace_id > workspace.id
import_job.job_id > job.id
import_row.import_job_id > import_job.id
import_row.application_id > application.id
export_job.file_id > file_object.id
resume_search_document.application_id > application.id
resume_search_document.file_id > file_object.id
