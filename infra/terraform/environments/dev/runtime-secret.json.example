{
  "DATABASE_URL": "jdbc:postgresql://<supabase-pooler-host>:5432/postgres?sslmode=require",
  "DATABASE_USERNAME": "<database-username>",
  "DATABASE_PASSWORD": "<database-password>",
  "TALON_SECURITY_ACCESS_SIGNING_KEY": "<base64-encoded-32-byte-key>",
  "TALON_SECURITY_REFRESH_HASH_KEY": "<different-base64-encoded-32-byte-key>",
  "TALON_DEMO_ADMIN_EMAIL": "admin@example.com",
  "TALON_DEMO_ADMIN_PASSWORD_HASH": "<bcrypt-hash>",
  "GROQ_API_KEY": "<groq-api-key-or-empty-string>"
}
