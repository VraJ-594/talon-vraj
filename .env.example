# Local PostgreSQL
POSTGRES_DB=talon
POSTGRES_USER=talon
POSTGRES_PASSWORD=talon_local
DATABASE_URL=jdbc:postgresql://localhost:5432/talon
DATABASE_USERNAME=talon
DATABASE_PASSWORD=talon_local
DATABASE_POOL_SIZE=8

# Local mail catcher
MAIL_HOST=localhost
MAIL_PORT=1025

# Integration mode; external credentials are introduced in later phases
AI_PROVIDER=DISABLED

# Application-owned authentication (replace placeholders only in an ignored local env file)
TALON_SECURITY_ENABLED=false
TALON_SECURITY_ISSUER=http://localhost:8080
TALON_SECURITY_AUDIENCE=talon-web
TALON_SECURITY_ACCESS_SIGNING_KEY=<base64-encoded-32-byte-key>
TALON_SECURITY_REFRESH_HASH_KEY=<different-base64-encoded-32-byte-key>
TALON_SECURITY_ACCESS_TOKEN_LIFETIME=15m
TALON_SECURITY_REFRESH_TOKEN_LIFETIME=7d

# Optional idempotent demo administrator provisioning
TALON_DEMO_ADMIN_ENABLED=false
TALON_DEMO_ADMIN_EMAIL=admin@example.com
TALON_DEMO_ADMIN_DISPLAY_NAME=Demo Administrator
TALON_DEMO_ADMIN_PASSWORD_HASH=<bcrypt-hash-only-never-plaintext>
TALON_DEMO_ADMIN_WORKSPACE_NAME=Talon Demo
TALON_DEMO_ADMIN_WORKSPACE_SLUG=talon-demo
TALON_DEMO_ADMIN_DEFAULT_TIMEZONE=Asia/Kolkata
